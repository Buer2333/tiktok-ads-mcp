# Copy to .env (or export in your MCP client config) and fill in.
# Credentials: https://business-api.tiktok.com/portal/ — grant read permissions for the
# endpoints you use (ad accounts, campaigns/ads, reporting, GMV Max, Business Center).

# Required
TIKTOK_APP_ID=your_app_id
TIKTOK_SECRET=your_app_secret
TIKTOK_ACCESS_TOKEN=your_access_token

# Optional: a second token (e.g. another Business Center), tried on permission errors
# TIKTOK_ACCESS_TOKEN_2=

# Optional: default advertiser for tools that take an advertiser_id
# TIKTOK_ADVERTISER_ID=

# Optional
# TIKTOK_SANDBOX=false          # true = sandbox-ads.tiktok.com
# TIKTOK_REQUEST_TIMEOUT=30     # seconds
# TIKTOK_ADS_PROXY=             # explicit proxy URL for business-api calls only
# LARK_BOT_CACHE_DIR=           # cache dir for FX rates (default ~/.cache/lark-bot)
